NODE_ENV=production
HOST=127.0.0.1
PORT=8000
APP_ORIGIN=https://map.example.org
EDITOR_ENABLED=false
EDITOR_STATE_DIR=/var/lib/greece-dance-editor
LIVE_INFO_DIR=/var/lib/greece-dance-content
EDITOR_PASSWORD_HASH=
SESSION_SECRET=
GITHUB_REPOSITORY=charlieboardman/greece-dance
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_PRIVATE_KEY_FILE=/etc/greece-dance/github-app.pem
CONTENT_BRANCH=main

# Same-origin OSM tile/glyph cache. Data is fetched only for visible map requests.
# Cached payload budget; SQLite metadata/journaling needs additional disk space.
MAP_CACHE_BYTES=1073741824
# Optional upstream changes do not require a frontend release.
OSM_TILE_BASE=https://vector.openstreetmap.org/shortbread_v1
OSM_GLYPH_BASE=https://vector.openstreetmap.org/styles/shortbread/fonts
