[Unit]
Description=National Dance Ministry Map and editor (Podman Compose, Node 24)
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/var/lib/containers/storage /var/lib/greece-dance-editor /var/lib/greece-dance-content

[Service]
Type=exec
ExecStart=/usr/local/lib/greece-dance/deploy/runtime.sh up --remove-orphans --exit-code-from app
ExecStop=/usr/local/lib/greece-dance/deploy/runtime.sh down
Restart=always
RestartSec=3
TimeoutStopSec=30
KillMode=mixed
UMask=0077

[Install]
WantedBy=multi-user.target
