HOST=127.0.0.1
PORT=8000
APP_ORIGIN=http://localhost:8000
NODE_ENV=development

# The public map works with the editor disabled. No requests go to GitHub.
EDITOR_ENABLED=false
# Generate with npm run password:hash and node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EDITOR_PASSWORD_HASH=
SESSION_SECRET=
GITHUB_REPOSITORY=charlieboardman/greece-dance
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_PRIVATE_KEY_FILE=/etc/greece-dance/github-app.pem
CONTENT_BRANCH=main
EDITOR_STATE_DIR=.state
# Set for Git-backed publication; leave unset to serve local info/ during development.
# LIVE_INFO_DIR=.state/published
